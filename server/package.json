{
  "name": "forgeai-server",
  "version": "1.0.0",
  "description": "ForgeAI Express + TypeScript backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "express",
    "typescript",
    "backend",
    "forgeai",
    "rag"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@better-auth/prisma-adapter": "^1.6.25",
    "@huggingface/transformers": "^3.3.3",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.3",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/pgvector": "^0.1.0",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.4.0",
    "@types/multer": "^2.2.0",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.25",
    "bullmq": "^5.41.7",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "duck-duck-scrape": "^2.2.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "google-sr": "^6.0.0",
    "googlethis": "^1.8.0",
    "helmet": "^8.3.0",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.5.4",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "uuid": "^11.1.1",
    "zod": "^3.24.2"
