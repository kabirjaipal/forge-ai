NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/forgeai?schema=public

# Redis Configuration
REDIS_URL=redis://redis:6379

# S3 / Cloud Object Storage Configuration (Backblaze B2 / AWS S3 / MinIO)
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here
S3_BUCKET=your_bucket_name
S3_FORCE_PATH_STYLE=true

# Authentication Secrets (Better Auth)
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3000

# AI Provider Key
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com

# AI Web Search API Key (Optional: Tavily AI Search for ChatGPT/Perplexity style search)
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith Tracing & Observability (Optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT="forge-ai"